# Desenvolvimento local. Substitua antes de iniciar o banco.
POSTGRES_PASSWORD=
# Opt-in. Aplicar migrations antes de habilitar; não executar em produção sem autorização.
IDENTITY_SESSION_CLEANUP_ENABLED=false
IDENTITY_SESSION_CLEANUP_BATCH_SIZE=100
IDENTITY_SESSION_CLEANUP_INTERVAL_MINUTES=15
# Portas vinculadas somente a loopback.
TRONO_WEB_PORT=8443
TRONO_API_PORT=5080
TRONO_DB_PORT=5432
